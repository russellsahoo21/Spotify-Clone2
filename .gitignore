# StreamYT Root Git Ignore Rules

# Ignore all environment configuration files
.env
.env.*
!.env.example

# Node dependencies and build files
**/node_modules/
**/dist/
**/build/
**/.expo/
**/web-build/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Python virtual envs and caches
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Local database files
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3

# IDE / System configurations
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
